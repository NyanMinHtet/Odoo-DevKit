<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Run List View -->
    <record id="view_data_seeder_run_list" model="ir.ui.view">
        <field name="name">data_seeder.run.list</field>
        <field name="model">data_seeder.run</field>
        <field name="arch" type="xml">
            <list string="Data Seeder Runs" create="false">
                <field name="name"/>
                <field name="scenario_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'running'"
                       decoration-danger="state == 'error'"/>
                <field name="customer_count"/>
                <field name="product_count"/>
                <field name="order_count"/>
                <field name="invoice_count"/>
                <field name="payment_count"/>
                <field name="execution_time"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <!-- Run Form View -->
    <record id="view_data_seeder_run_form" model="ir.ui.view">
        <field name="name">data_seeder.run.form</field>
        <field name="model">data_seeder.run</field>
        <field name="arch" type="xml">
            <form string="Data Seeder Run" create="false" edit="false">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,running,done,error"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>

                    <group string="Summary">
                        <group string="Record Counts">
                            <field name="customer_count"/>
                            <field name="product_count"/>
                            <field name="order_count"/>
                            <field name="invoice_count"/>
                            <field name="payment_count"/>
                        </group>
                        <group string="Execution Info">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="execution_time"/>
                            <field name="total_records"/>
                        </group>
                    </group>

                    <group string="Configuration">
                        <field name="config_json" readonly="True"/>
                    </group>

                    <group string="Generated Records">
                        <field name="generated_customer_ids" readonly="True"/>
                        <field name="generated_product_ids" readonly="True"/>
                        <field name="generated_order_ids" readonly="True"/>
                        <field name="generated_invoice_ids" readonly="True"/>
                    </group>

                    <group string="Logs">
                        <field name="log" readonly="True" colspan="2"/>
                    </group>

                    <group string="Error" invisible="state != 'error'">
                        <field name="error_message" readonly="True" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Run Search View -->
    <record id="view_data_seeder_run_search" model="ir.ui.view">
        <field name="name">data_seeder.run.search</field>
        <field name="model">data_seeder.run</field>
        <field name="arch" type="xml">
            <search string="Data Seeder Runs">
                <field name="name"/>
                <field name="scenario_type"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Running" name="running" domain="[('state', '=', 'running')]"/>
                <filter string="Error" name="error" domain="[('state', '=', 'error')]"/>
                <group expand="0" string="Group By">
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Scenario" name="group_scenario" context="{'group_by': 'scenario_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Run Action -->
    <record id="action_data_seeder_run" model="ir.actions.act_window">
        <field name="name">Data Seeder Runs</field>
        <field name="res_model">data_seeder.run</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_data_seeder_run_search"/>
        <field name="context">{'create': False}</field>
    </record>

</odoo>
